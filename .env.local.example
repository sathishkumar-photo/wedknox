# LOCATION: reference copy. Your REAL file is called .env.local, next to package.json.
# Never share .env.local and never upload it to GitHub.

# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-or-secret-key-here

# --- Admin login ---
# The email of the user you create in Supabase > Authentication > Users. Several admins: separate with commas.
ADMIN_EMAIL=you@example.com
# Any long random text (32+ characters). Used to sign the "logged in" cookie.
ADMIN_SESSION_SECRET=paste-a-long-random-text-here-at-least-32-characters
